<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="horizontal"
    android:background="@drawable/wehavephones_screen_background">
    <ScrollView
        android:id="@+id/WeHavePhonesRail"
        android:layout_width="190dp"
        android:layout_height="match_parent"
        android:background="@drawable/wehavephones_rail_background"
        android:elevation="0dp"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="10dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/azeroid_mark"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/TVWeHavePhonesLogo"
                    style="@style/WeHavePhonesHeader"
                    android:paddingLeft="8dp"
                    android:letterSpacing="0.15"
                    android:text="@string/wehavephones_logo"
                    android:textAllCaps="true"
                    android:textSize="17sp"
                    android:fontFamily="@font/azeroid_display"
                    android:textColor="@color/wehavephones_accent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="2" />
            </LinearLayout>
            <ImageView
                style="@style/WeHavePhonesDivider"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp"
                android:layout_height="1dp" />
            <TextView
                android:id="@+id/RailPlay"
                style="@style/WeHavePhonesRailItem"
                android:drawableStart="@drawable/wehavephones_ic_play"
                android:text="@string/wehavephones_play" />
            <TextView
                android:id="@+id/RailAddons"
                style="@style/WeHavePhonesRailItem"
                android:drawableStart="@drawable/wehavephones_ic_addons"
                android:text="@string/wehavephones_addons" />
            <TextView
                android:id="@+id/RailSetup"
                style="@style/WeHavePhonesRailItem"
                android:drawableStart="@drawable/wehavephones_ic_setup"
                android:text="@string/wehavephones_setup_short" />
            <TextView
                android:id="@+id/RailSettings"
                style="@style/WeHavePhonesRailItem"
                android:drawableStart="@drawable/wehavephones_ic_settings"
                android:text="@string/wehavephones_settings" />
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="4dp" />
            <TextView
                android:id="@+id/RailRuntime"
                style="@style/WeHavePhonesRailTool"
                android:drawableStart="@drawable/wehavephones_ic_runtime"
                android:text="@string/wehavephones_runtime" />
            <TextView
                android:id="@+id/RailDiagnostics"
                style="@style/WeHavePhonesRailTool"
                android:drawableStart="@drawable/wehavephones_ic_diagnostics"
                android:text="@string/wehavephones_diagnostics" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/wehavephones_lcd_frame"
            android:padding="10dp">
            <com.wehavephones.mobile.WeHavePhonesAtmosphereView
                android:id="@+id/VAtmosphere"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <FrameLayout
                android:id="@+id/FLWeHavePhonesScreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:text="@string/wehavephones_disclaimer"
            android:textColor="#8E98A6"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
